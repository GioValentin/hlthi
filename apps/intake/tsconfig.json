{
  "extends": "tsconfig/react.json",
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext.array", "dom", "es2022"],
    "module": "ESNext",
    "moduleResolution": "node",
    "sourceMap": true,
    "inlineSources": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "./telemed/pages/Welcome": ["../../../custom-packages/ui-components/lib/pages/Welcome"],
      "@theme/*": ["src/themes/ottehr/*"],
      "@defaultTheme/*": ["src/themes/ottehr/*"]
    }
  },
  "include": [".", ".eslintrc.cjs","../../../custom-packages/ui-components/lib"]
}
